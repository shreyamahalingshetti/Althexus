# Server configuration
PORT=5000

# Database Configuration (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/althexus?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Seeding Configuration
SEED_ADMIN_EMAIL=admin@xyz.com
SEED_ADMIN_PASSWORD=your_secure_seed_password_here

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

