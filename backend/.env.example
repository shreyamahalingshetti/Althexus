# Server configuration
PORT=5000

# Database Configuration (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/althexus?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Seeding Configuration
SEED_ADMIN_EMAIL=admin@althexus.com
SEED_ADMIN_PASSWORD=your_secure_seed_password_here

